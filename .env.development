# ============================================
# 開發環境配置
# 從 Vue 2 專案轉換而來
# Vue 3 使用 VITE_ 前綴（而非 Vue 2 的 VUE_APP_ 前綴）
# ============================================

# 網站標題
VITE_APP_TITLE=Vue3 Antdv Admin

# 網站部署的目錄
VITE_BASE_URL=/

# ============================================
# API 接口路徑配置
# ============================================

# 原有專案使用的 API 基礎 URL（用於 src/utils/request.ts）
VITE_BASE_API_URL=http://127.0.0.1:7001

# 從 Vue 2 專案整合：AdminSystem API 基礎 URL
# 對應原 Vue 2 的 VUE_APP_BASE_API
VITE_APP_BASE_API=https://admin-api.jp68-king.com/

# 從 Vue 2 專案整合：CDN 基礎 URL（可選）
# 如果原 Vue 2 專案有 VUE_APP_CDN_BASE_URL，請在這裡設定
VITE_APP_CDN_BASE_URL=

# ============================================
# Socket 配置
# ============================================

# Socket 請求路徑前綴
VITE_BASE_SOCKET_PATH=/socket.io

# Socket 命名空間
VITE_BASE_SOCKET_NSP=/socket.io

# ============================================
# Mock 配置
# ============================================

# Mock API 路徑
VITE_MOCK_API=/mock-api

# 是否在生產環境啟用 mock（true/false）
VITE_MOCK_IN_PROD=false

# ============================================
# 其他配置
# ============================================

# 是否移除 console（開發環境建議設為 false）
VITE_DROP_CONSOLE=false