// Pinia Store 範例（從 Vuex 轉換）
// 來源：src/store/modules/user.ts
// 注意：這是參考範例，需要根據目標專案的 Pinia 設定調整

import { defineStore } from "pinia";
import { loginLocal, getUserInfoLocal, logoutLocal } from "@/api/users";
import { getToken, setToken, removeToken } from "@/utils/cookies";
import router from "@/router";
// import { getBackendKey } from "@/api/admin";
// import { Buffer } from "buffer";

export interface IUserState {
  token: string;
  name: string;
  avatar: string;
  introduction: string;
  roles: string[];
  email: string;
  account?: string;
  level: number;
  website: string;
  masterAgent: string;
  agent: string;
  currencies: string[];
  shareholder: string;
}

export const useUserStore = defineStore("user", {
  state: (): IUserState => ({
    token: getToken() || "",
    name: "",
    avatar: "",
    introduction: "",
    roles: [],
    email: "",
    level: -1,
    website: "",
    masterAgent: "",
    agent: "",
    currencies: [],
    account: "",
    shareholder: ""
  }),

  getters: {
    // 可以添加 getters
  },

  actions: {
    // 登入
    async login(userInfo: { account: string; password: string }) {
      let { account, password } = userInfo;
      account = account.trim();
      const { data } = await loginLocal({ account, password });
      let Authenticator = false;
      let id = "";

      if (data.userData && data.userData.id) {
        id = data.userData.id;
      }
      if (data.authenticator) {
        Authenticator = data.authenticator;
      }

      if (!Authenticator) {
        if (data) {
          setToken(data.accessToken);
          this.token = data.accessToken;
          this.masterAgent = data.userData.masterAgent;
          this.agent = data.userData.agent;
          this.currencies = data.userData.currencies;
        }
      } else {
        return Authenticator;
      }
    },

    // 雙因素驗證登入
    async login2(userInfo: { account: string; password: string; backendKey: string }) {
      // 注意：需要安裝 speakeasy 和 base32.js
      // const { account, password, backendKey } = userInfo;
      // account = account.trim();
      // const { data } = await loginLocal({ account, password });
      // ... 雙因素驗證邏輯
      // 參考原始檔案 src/store/modules/user.ts 第 129-165 行
    },

    // 取得使用者資訊
    async getUserInfo() {
      if (this.token === "") {
        throw Error("GetUserInfo: token is undefined!");
      }
      const { data } = await getUserInfoLocal({ token: this.token });
      if (!data) {
        throw Error("Verification failed, please Login again.");
      }

      const { roles, name, avatar, introduction, email, level, website, masterAgentAccount, agent, currencies, account, shareholder } = data;

      if (!roles || roles.length <= 0) {
        throw Error("GetUserInfo: roles must be a non-null array!");
      }

      this.roles = roles;
      this.name = name;
      this.avatar = avatar;
      this.introduction = introduction;
      this.email = email;
      this.level = level;
      this.website = website;
      if (this.masterAgent.length === 0 && level >= 4) {
        this.masterAgent = masterAgentAccount;
      }
      this.agent = agent;
      this.currencies = currencies;
      this.account = account;
      if (level >= 3) {
        this.shareholder = shareholder?.account || "";
      }
    },

    // 登出
    async logout() {
      if (this.token === "") {
        throw Error("LogOut: token is undefined!");
      }
      await logoutLocal({});
      removeToken();
      // 注意：Vue Router 4 的路由重置方式可能不同
      // resetRouter();
      this.token = "";
      this.roles = [];
    },

    // 重置 Token
    resetToken() {
      removeToken();
      this.token = "";
      this.roles = [];
    }
  }
});

